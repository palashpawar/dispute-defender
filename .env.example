# --- AI (required for Claude analysis; without it a simple rules engine is used) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium          # low | medium | high | xhigh | max
# ANTHROPIC_FALLBACKS=1            # server-side refusal fallbacks; set 0 to disable

# --- PayPal sandbox (optional; leave blank to run against the built-in mock sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# PAYPAL_WEBHOOK_ID=               # from your sandbox app's webhook config, for signature verification
# PAYPAL_MODE=auto                 # auto | mock
